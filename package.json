{
  "name": "voxelcraft",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "description": "A modular Minecraft-inspired voxel sandbox with a survival crafting loop, built with Three.js and TypeScript.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:deploy": "npm run typecheck && npm run test:ci && npm run build",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.2.6",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
